name = "chuanqiai-license-api"
main = "src/index.js"
compatibility_date = "2026-07-01"

[vars]
GITHUB_OWNER = "jialinhe52-boop"
GITHUB_REPO = "chuanqiai-license-data"
GITHUB_BRANCH = "main"
GITHUB_DATA_PATH = "data/licenses.json"
PRODUCT_ID = "legend-comic-generator"
ADMIN_SITE_URL = "https://admin.chuanqiai.xyz/admin/"
ALLOWED_ORIGINS = "https://admin.chuanqiai.xyz,https://jialinhe52-boop.github.io"
CHECK_INTERVAL_HOURS = "24"

# 使用 Cloudflare Secret 保存：
# GITHUB_TOKEN
# ADMIN_TOKEN
# LICENSE_PRIVATE_KEY_B64
